{
    "manifest_version": 3,
    "name": "__MSG_name__",
    "default_locale": "en",
    "version": "0.4.3",
    "description": "__MSG_description__",
    "permissions": ["storage", "alarms", "notifications", "activeTab", "scripting"],
    "host_permissions": ["https://djinni.co/*", "https://jobs.dou.ua/*", "https://api.telegram.org/*"],
    "background": { "service_worker": "background.js", "type": "module" },
    "action": {
        "default_title": "__MSG_actionTitle__",
        "default_popup": "popup.html",
        "default_icon": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon.png" }
    },
    "options_page": "options.html",
    "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon.png" },
    "key": ""
}
